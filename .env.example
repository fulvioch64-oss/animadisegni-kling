# Gateway endpoint accepting JSON { imageUrl, motionPreset } and Bearer authentication.
KLING_API_URL=
KLING_API_KEY=
# Optional status endpoint; use {taskId} where the provider expects the task ID.
KLING_API_STATUS_URL=
# Stripe checkout: secret key, webhook signing secret (endpoint /api/stripe-webhook) and one Price ID per package.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_FAMILY=
NEXT_PUBLIC_STRIPE_PRICE_PARTY=
NEXT_PUBLIC_STRIPE_PRICE_SCHOOL=
# LemonSqueezy (legacy, only for the existing /api/webhook): one variant ID per credit package (Variant ID, not Product ID).
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_FAMILY=
LEMONSQUEEZY_VARIANT_ID_PARTY=
LEMONSQUEEZY_VARIANT_ID_SCHOOL=
LEMON_WEBHOOK_SECRET=
# Required to create each checkout from its Variant ID via the LemonSqueezy API.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Public base URL of the app (used for checkout redirects).
PUBLIC_BASE_URL=http://localhost:3000
# Google sign-in: OAuth Web Client ID (public) and a random secret of 32+ characters that signs session cookies.
GOOGLE_CLIENT_ID=
AUTH_SESSION_SECRET=
