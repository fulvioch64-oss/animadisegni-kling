# Gateway endpoint accepting JSON { imageUrl, motionPreset } and Bearer authentication.
KLING_API_URL=
KLING_API_KEY=
# Optional status endpoint; use {taskId} where the provider expects the task ID.
KLING_API_STATUS_URL=
# Vercel Blob is used when configured; otherwise local development writes expiring public/uploads files.
BLOB_READ_WRITE_TOKEN=
LEMON_CHECKOUT_URL=
LEMON_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_ID=
# Set this to a publicly reachable base URL/tunnel when using local upload fallback with Kling.
PUBLIC_BASE_URL=http://localhost:3000
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Payment simulation is only enabled on the local server.
LOCAL_PAYMENT_SIMULATION=true
